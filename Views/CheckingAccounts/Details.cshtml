@model csharp_sprint1_stories.Models.CheckingAccount

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>CheckingAccount</h4>
    <hr />
    @if (TempData["IssuedCheckNumber"] != null)
    {
        <div class="alert alert-success">
            Issued check number: @TempData["IssuedCheckNumber"]
        </div>
    }
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NextCheckNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NextCheckNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OverdraftLimit)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OverdraftLimit)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Account)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Account.AccountId)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.AccountId">Edit</a> |
    <a asp-action="Index">Back to List</a>
    <form asp-action="GetNextCheckNumber" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.AccountId" />
        <button type="submit" class="btn btn-primary ms-2">Get Next Check Number</button>
    </form>
</div>
