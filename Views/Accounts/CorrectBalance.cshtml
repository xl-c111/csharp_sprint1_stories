@model csharp_sprint1_stories.Models.Account

@{
  ViewData["Title"] = "Correct Balance";
}

<h1>Correct Balance</h1>

<h4>Account</h4>
<hr />

<div>
  <p><strong>Account ID:</strong> @Model.AccountId</p>
  <p><strong>Customer:</strong> @Model.Customer?.Name</p>
  <p><strong>Account Type:</strong> @Model.AccountType</p>
  <p><strong>Current Balance:</strong> @Model.Balance</p>
</div>

<form asp-action="CorrectBalance" method="post">
  <input type="hidden" name="id" value="@Model.AccountId" />

  <div class="form-group">
    <label for="amount" class="control-label">New Balance</label>
    <input type="number" step="0.01" name="amount" class="form-control" />
  </div>

  <div asp-validation-summary="All" class="text-danger"></div>

  <div class="form-group mt-3">
    <input type="submit" value="Save Balance" class="btn btn-primary" />
    <a asp-action="Details" asp-route-id="@Model.AccountId" class="btn btn-secondary">Back to Details</a>
  </div>
</form>
